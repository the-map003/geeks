# Root environment used by docker-compose. Each workspace also has its own .env.example
# for local development (backend/.env, frontend/.env, executor/.env). Run `npm run setup`.

# ---- PostgreSQL (docker-compose "postgres" service) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=geeks
POSTGRES_PORT=5432

# ---- Backend ----
JWT_ACCESS_SECRET=replace-with-64-random-characters-access
JWT_REFRESH_SECRET=replace-with-64-random-characters-refresh
EXECUTOR_KEY=replace-with-random-shared-secret
PUBLIC_SITE_URL=https://example.com
CORS_ORIGIN=https://example.com

# ---- Nginx ----
HTTP_PORT=80
