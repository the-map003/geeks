# Code-execution service (never expose publicly; only the backend talks to it)
PORT=5000
HOST=127.0.0.1
EXECUTOR_KEY=dev-executor-key-change-me

# Driver: "docker" (production, isolated containers) or "local" (development only).
# The local driver spawns interpreters installed on the host with time limits but
# WITHOUT sandboxing. It refuses to start unless EXECUTOR_ALLOW_LOCAL=true.
EXECUTOR_DRIVER=local
EXECUTOR_ALLOW_LOCAL=true

# Local driver: interpreters available on this machine (comma-separated subset of PYTHON,JAVASCRIPT,CPP,JAVA)
LOCAL_LANGUAGES=PYTHON,JAVASCRIPT
# On Windows the `python` on PATH may be the Microsoft Store stub; use the full path of a real
# interpreter, e.g. C:\Users\<you>\AppData\Local\Programs\Python\Python314\python.exe
PYTHON_BIN=python3
NODE_BIN=node
GPP_BIN=g++
JAVAC_BIN=javac
JAVA_BIN=java

# Docker driver
DOCKER_BIN=docker
DOCKER_IMAGE_PYTHON=python:3.12-alpine
DOCKER_IMAGE_JAVASCRIPT=node:22-alpine
DOCKER_IMAGE_CPP=gcc:14
DOCKER_IMAGE_JAVA=eclipse-temurin:21-jdk-alpine

MAX_CONCURRENT_RUNS=4
WORK_DIR=./tmp
