# Backend development environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Embedded PostgreSQL started by `npm run db:start` at the repo root (port 5433 avoids clashing
# with a system PostgreSQL). In Docker Compose this is overridden to the `postgres` service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/geeks?schema=public

# JWT (development values only — generate 64+ random characters for production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Code-execution service
EXECUTOR_URL=http://localhost:5000
EXECUTOR_KEY=dev-executor-key-change-me
